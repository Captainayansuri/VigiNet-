generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CITIZEN
  FIELD_RESPONDER
  TEAM_LEAD
  DISTRICT_OFFICER
  REGIONAL_OFFICER
  ADMIN
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  QUEUED_OFFLINE
  RECEIVED
  UNDER_REVIEW
  VERIFIED
  DISPUTED
  REJECTED
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  VERIFIED
  RESOLVED
  CLOSED
}

enum IncidentPriority {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum MissionStatus {
  DRAFT
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ON_SCENE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ABORTED
  UNABLE_TO_REACH
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertSourceType {
  GOVERNMENT
  WEATHER
  SENSOR
  MANUAL
  SIMULATED
}

enum EvidenceType {
  PHOTO
  VIDEO
  AUDIO
  DOCUMENT
}

enum VerificationStatus {
  UNVERIFIED
  CONFIRMED
  DISPUTED
  NEEDS_MORE_EVIDENCE
}

enum DeviceSource {
  GPS
  NETWORK
  MANUAL
  ADJUSTED
}

enum NotificationPriority {
  NORMAL
  HIGH
  CRITICAL
}

model User {
  id               String          @id @default(cuid())
  email            String?         @unique
  passwordHash     String?
  phone            String?
  role             UserRole        @default(CITIZEN)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  citizenProfile   CitizenProfile?
  responderProfile ResponderProfile?
  reports          Report[]
  auditEvents      AuditEvent[]
  notifications    Notification[]
  verificationLogs VerificationRecord[]
  fieldUpdates     FieldUpdate[]
}

model CitizenProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  fullName       String?
  village        String?
  district       String?
  preferredLang  String?
  locationLat    Float?
  locationLng    Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResponderProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  teamId         String?
  fullName       String?
  designation    String?
  status         String?  @default("AVAILABLE")
  lastSeenAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team           Team?    @relation(fields: [teamId], references: [id])
}

model Team {
  id          String             @id @default(cuid())
  teamName    String
  status      String             @default("AVAILABLE")
  capabilities String[]
  currentAssignment String?
  locationLat Float?
  locationLng Float?
  lastSeenAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     ResponderProfile[]
  missions    Mission[]
}

model Report {
  id               String        @id @default(cuid())
  citizenId        String?
  incidentId       String?
  type             String
  title            String?
  description      String
  severity         IncidentPriority @default(MODERATE)
  status           ReportStatus   @default(SUBMITTED)
  source           String         @default("APP")
  latitude         Float?
  longitude        Float?
  accuracyMeters   Float?
  village          String?
  district         String?
  locationText     String?
  locationSource   DeviceSource?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  mediaMetadata    Json?
  externalRef      String?
  incident         Incident?      @relation(fields: [incidentId], references: [id])
  citizen          User?          @relation(fields: [citizenId], references: [id])
  evidence         Evidence[]
  verification     VerificationRecord[]
  notifications    Notification[]
  auditEvents      AuditEvent[]
}

model Incident {
  id                String          @id @default(cuid())
  incidentCode      String          @unique
  title             String
  description       String
  category          String
  severity          IncidentPriority @default(MODERATE)
  status            IncidentStatus  @default(OPEN)
  latitude          Float?
  longitude         Float?
  accuracy          String?
  area              String?
  district          String?
  state             String?
  affectedArea      String?
  radiusMeters      Float?
  locationText      String?
  confidence        String?
  summary           String?
  knownFacts        String[]        @default([])
  unknownFacts      String[]        @default([])
  reportedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  reports           Report[]
  evidence          Evidence[]
  missions          Mission[]
  alerts            Alert[]
  verification      VerificationRecord[]
  auditEvents       AuditEvent[]
}

model Evidence {
  id             String       @id @default(cuid())
  reportId       String?
  incidentId     String?
  type           EvidenceType
  storageKey     String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime     @default(now())
  locationLat    Float?
  locationLng    Float?
  metadata       Json?
  report         Report?      @relation(fields: [reportId], references: [id], onDelete: SetNull)
  incident       Incident?    @relation(fields: [incidentId], references: [id], onDelete: SetNull)
}

model VerificationRecord {
  id           String             @id @default(cuid())
  reportId     String?
  incidentId   String?
  responderId  String?
  status       VerificationStatus @default(UNVERIFIED)
  reason       String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  report       Report?            @relation(fields: [reportId], references: [id], onDelete: SetNull)
  incident     Incident?          @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  responder    User?              @relation(fields: [responderId], references: [id], onDelete: SetNull)
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String?
  createdAt DateTime @default(now())
  @@unique([teamId, userId])
}

model Mission {
  id                 String        @id @default(cuid())
  incidentId         String?
  teamId             String?
  title              String
  objective          String?
  status             MissionStatus @default(DRAFT)
  priority           IncidentPriority @default(MODERATE)
  priorityOverridden Boolean       @default(false)
  location           String?
  etaMinutes         Int?
  hazards            String[]      @default([])
  lat                Float?
  lon                Float?
  accuracy           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  incident           Incident?     @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  team               Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  fieldUpdates       FieldUpdate[]
}

model FieldUpdate {
  id            String    @id @default(cuid())
  missionId     String
  responderId   String?
  description   String
  locationText  String?
  latitude      Float?
  longitude     Float?
  affectedPeople Int?
  createdAt     DateTime  @default(now())
  mission       Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  responder     User?     @relation(fields: [responderId], references: [id], onDelete: SetNull)
}

model Alert {
  id            String        @id @default(cuid())
  incidentId    String?
  title         String
  description   String
  severity      AlertSeverity @default(MEDIUM)
  sourceType    AlertSourceType
  sourceName    String?
  latitude      Float?
  longitude     Float?
  radiusMeters  Float?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  incident      Incident?     @relation(fields: [incidentId], references: [id], onDelete: SetNull)
}

model Shelter {
  id          String   @id @default(cuid())
  name        String
  latitude    Float?
  longitude   Float?
  capacity    Int?
  status      String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Hazard {
  id          String   @id @default(cuid())
  name        String
  type        String?
  severity    String?
  latitude    Float?
  longitude   Float?
  radiusMeters Float?
  x           String?
  y           String?
  size        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sensor {
  id          String   @id @default(cuid())
  name        String
  type        String
  latitude    Float?
  longitude   Float?
  reading     String?
  unit        String?
  isSimulated Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id          String               @id @default(cuid())
  userId      String?
  title       String
  message     String
  priority    NotificationPriority @default(NORMAL)
  isRead      Boolean              @default(false)
  createdAt   DateTime             @default(now())
  createdBy   String?
  reportId    String?
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  report      Report?              @relation(fields: [reportId], references: [id], onDelete: SetNull)
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  incidentId String?
  reportId  String?
  timestamp DateTime @default(now())
  metadata  Json?
  user      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  incident  Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  report    Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
}
