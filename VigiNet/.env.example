# VigiNet Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viginet?schema=public"

# Authentication Secrets
JWT_SECRET="viginet-development-secret-jwt-key-2026"
SESSION_SECRET="viginet-development-session-secret"

# Storage Settings (Local development storage)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage

# External API Integration Configuration (Simulated/mocked for Phase 1)
GOVERNMENT_ALERTS_URL=
WEATHER_API_URL=
SENSOR_FEED_URL=
